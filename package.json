{
    "name": "miniTSis-monorepo",

    "packageManager": "npm@10.2.3",

    "version": "1.0.0",
    "description": "monorepo for miniTSis",
    "license": "Apache-2.0",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/lambdamechanic/miniTSis.git"
    },
    "homepage": "https://github.com/lambdamechanic/miniTSis#readme",
    "bugs": {
        "url": "https://github.com/lambdamechanic/miniTSis/issues"
    },
    "keywords": [
        "typescript",
        "property-based-testing",
        "generative-testing",
        "shrinking",
        "minitsis"
    ],
    "private": true,
    "workspaces": [
        "packages/*"
    ],
    "dependencies": {
        "typescript": "^5.4.2"
    },
    "devDependencies": {
        "@changesets/cli": "^2.27.1",
        "@types/node": "^20.11.25",
        "changeset": "^0.2.6",
        "gts": "^5.2.0",
        "turbo": "^2.3.3",
        "ts-node": "^10.9.2",
        "tsup": "^8.0.2"
    },
    "scripts": {
        "dev": "turbo run dev",
        "release:check-prereqs": "bash .github/scripts/check-release-prereqs.sh",
        "release:validate-artifact-coupling": "bash scripts/release/validate-artifact-coupling.sh",
        "release:validate-missing-prereq": "bash scripts/release/validate-missing-prereq.sh",
        "publish-packages": "npm exec --no -- changeset version && npm exec --no -- turbo run build lint test && npm exec --no -- changeset publish"
    }
}
