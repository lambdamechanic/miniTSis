        {"path": "./packages/minitsis-datastore"},
        {"path": "./packages/minitsis-node"},
        {"path": "./packages/minitsis-browser"},
        {"path": "./packages/minitsis"},
        {"path": "./packages/minitsis-testkit"}
    ]
}
