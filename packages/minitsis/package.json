{
    "name": "minitsis",
    "version": "6.0.4",
    "description": "Core tiny immutable state container for TypeScript.",
    "main": "dist/index.js",
    "types": "build/index.d.ts",
    "files": [
        "dist/",
        "build/"
    ],
    "license": "Apache-2.0",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/lambdamechanic/miniTSis.git"
    },
    "homepage": "https://github.com/lambdamechanic/miniTSis#readme",
    "bugs": {
        "url": "https://github.com/lambdamechanic/miniTSis/issues"
    },
    "keywords": [
        "typescript",
        "state",
        "immutable",
        "store",
        "minitsis"
    ],
    "scripts": {
        "build": "npm run compile && tsup src/index.ts --format cjs,esm --tsconfig ./tsconfig.json",
        "compile": "tsc",
        "test": "echo \"Tests moved to minitsis-testkit; run env packages instead\""
    },
    "engines": {
        "node": ">=14.14.0"
    },
    "dependencies": {
        "minitsis-datastore": "^6.0.4",
        "uuid": "*"
    },
    "devDependencies": {
        "@types/node": "^20.11.25",
        "typescript": "~5.2.0"
    },
    "publishConfig": {
        "access": "public"
    },
    "exports": {
        ".": {
            "import": "./dist/index.mjs",
            "require": "./dist/index.js"
        }
    }
}
