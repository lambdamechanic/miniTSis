{ "compilerOptions":
  {
      "rootDir": "src",
      "outDir": "build",
      "moduleResolution": "Bundler",
      "esModuleInterop": true,
      "target": "ES2020",
      "module": "ESNext",
      "preserveSymlinks": true,
      "declaration": true,
      "declarationMap": true,
      "sourceMap": true,
      "composite": true
  }
,
  "include": ["src/**/*"],
  "exclude": ["test", "dist", "build", "node_modules"]
}
