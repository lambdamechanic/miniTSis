{
    "name": "minitsis-datastore",
    "version": "1.3.1",
    "description": "",
    "main": "./dist/index.js",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.ts",
    "license": "Apache-2.0",
    "keywords": [],
    "scripts": {
        "build": "tsup src/index.ts --format cjs,esm --dts",
        "compile": "tsc",
        "pretest": "npm run compile"
    },
    "devDependencies": {
        "tsup": "^8.0.2",
        "typescript": "~5.2.0"
    },
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.mjs",
            "require": "./dist/index.js"
        }
    },
    "typesVersions": {
        "*": {
            "*": ["./dist/index.d.ts"]
        }
    }
}
