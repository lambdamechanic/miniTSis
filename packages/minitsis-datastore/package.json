{
    "name": "minitsis-datastore",
    "version": "6.0.4",
    "description": "Shared datastore interfaces and helpers for miniTSis adapters.",
    "main": "./dist/index.js",
    "module": "./dist/index.mjs",
    "types": "./build/index.d.ts",
    "license": "Apache-2.0",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/lambdamechanic/miniTSis.git"
    },
    "homepage": "https://github.com/lambdamechanic/miniTSis#readme",
    "bugs": {
        "url": "https://github.com/lambdamechanic/miniTSis/issues"
    },
    "keywords": [
        "typescript",
        "state",
        "immutable",
        "datastore",
        "minitsis"
    ],
    "files": [
        "dist/",
        "build/"
    ],
    "scripts": {
        "build": "npm run compile && tsup src/index.ts --format cjs,esm --tsconfig ./tsconfig.json",
        "compile": "tsc",
        "pretest": "npm run compile"
    },
    "devDependencies": {
        "tsup": "^8.0.2",
        "typescript": "~5.2.0"
    },
    "publishConfig": {
        "access": "public"
    },
    "exports": {
        ".": {
            "types": "./build/index.d.ts",
            "import": "./dist/index.mjs",
            "require": "./dist/index.js"
        }
    },
    "typesVersions": {
        "*": {
            "*": ["./build/index.d.ts"]
        }
    }
}
