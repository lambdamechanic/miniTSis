{
    "name": "minitsis-datastore",
    "version": "6.1.0",
    "description": "",
    "main": "./dist/index.js",
    "module": "./dist/index.mjs",
    "types": "./build/index.d.ts",
    "license": "Apache-2.0",
    "keywords": [],
    "files": [
        "dist/",
        "build/"
    ],
    "scripts": {
        "build": "npm run compile && tsup src/index.ts --format cjs,esm --tsconfig ./tsconfig.json",
        "compile": "tsc",
        "pretest": "npm run compile"
    },
    "devDependencies": {
        "tsup": "^8.0.2",
        "typescript": "~5.2.0"
    },
    "publishConfig": {
        "access": "public"
    },
    "exports": {
        ".": {
            "types": "./build/index.d.ts",
            "import": "./dist/index.mjs",
            "require": "./dist/index.js"
        }
    },
    "typesVersions": {
        "*": {
            "*": [
                "./build/index.d.ts"
            ]
        }
    }
}
