{
    "name": "minitsis-node",
    "version": "6.0.4",
    "description": "Node.js persistence adapter for miniTSis.",
    "main": "dist/index.js",
    "types": "build/index.d.ts",
    "files": [
        "dist/",
        "build/"
    ],
    "license": "Apache-2.0",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/lambdamechanic/miniTSis.git"
    },
    "homepage": "https://github.com/lambdamechanic/miniTSis#readme",
    "bugs": {
        "url": "https://github.com/lambdamechanic/miniTSis/issues"
    },
    "keywords": [
        "typescript",
        "state",
        "immutable",
        "node",
        "minitsis"
    ],
    "scripts": {
        "build": "npm run compile && tsup src/index.ts --format cjs,esm --tsconfig ./tsconfig.json",
        "compile": "tsc --build",
        "pretest": "npm run compile",
        "test": "jest"
    },
    "engines": {
        "node": ">=14.14.0"
    },
    "dependencies": {
        "minitsis": "^6.0.4",
        "minitsis-datastore": "^6.0.4",
        "nedb-promises": "^6.2.3"
    },
    "exports": {
        ".": {
            "import": "./dist/index.mjs",
            "require": "./dist/index.js"
        }
    },
    "devDependencies": {
        "minitsis-testkit": "^6.0.4",
        "@types/jest": "^29.5.12",
        "@types/node": "^20.11.25",
        "jest": "^29.7.0",
        "ts-jest": "^29.1.2",
        "typescript": "~5.2.0"
    },
    "publishConfig": {
        "access": "public"
    }
}
