{
    "name": "minitsis-browser",
    "version": "6.0.4",
    "description": "Browser persistence adapter for miniTSis using LocalForage.",
    "main": "dist/index.js",
    "module": "./dist/index.mjs",
    "types": "build/index.d.ts",
    "files": [
        "dist/",
        "build/"
    ],
    "dependencies": {
        "minitsis": "^6.0.4",
        "minitsis-datastore": "^6.0.4",
        "localforage": "^1.10.0"
    },
    "license": "Apache-2.0",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/lambdamechanic/miniTSis.git"
    },
    "homepage": "https://github.com/lambdamechanic/miniTSis#readme",
    "bugs": {
        "url": "https://github.com/lambdamechanic/miniTSis/issues"
    },
    "keywords": [
        "typescript",
        "state",
        "immutable",
        "browser",
        "minitsis"
    ],
    "scripts": {
        "build": "npm run compile && tsup src/index.ts --format cjs,esm --tsconfig ./tsconfig.json",
        "compile": "tsc --build",
        "test": "jest"
    },
    "exports": {
        ".": {
            "import": "./dist/index.mjs",
            "require": "./dist/index.js",
            "types": "./build/index.d.ts"
        }
    },
    "devDependencies": {
        "minitsis-testkit": "^6.0.4",
        "@types/jest": "^29.5.12",
        "jest": "^29.7.0",
        "ts-jest": "^29.1.2",
        "typescript": "~5.2.0",
        "jest-environment-jsdom": "^29.7.0"
    },
    "publishConfig": {
        "access": "public"
    }
}
