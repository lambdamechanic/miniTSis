{
    "name": "minitsis-browser",
    "version": "1.3.0",
    "main": "dist/index.js",
    "module": "./dist/index.mjs",
    "types": "build/index.d.ts",
    "files": [
        "dist/",
        "build/"
    ],
    "dependencies": {
        "@minitsis/core": "^6.0.3",
        "minitsis-datastore": "^1.3.1",
        "localforage": "^1.10.0"
    },
    "scripts": {
        "build": "npm run compile && tsup src/index.ts --format cjs,esm --tsconfig ./tsconfig.json",
        "compile": "tsc --build",
        "test": "jest"
    },
    "exports": {
        ".": {
            "import": "./dist/index.mjs",
            "require": "./dist/index.js",
            "types": "./build/index.d.ts"
        }
    },
    "devDependencies": {
        "@minitsis/testkit": "0.1.0",
        "@types/jest": "^29.5.12",
        "jest": "^29.7.0",
        "ts-jest": "^29.1.2",
        "typescript": "~5.2.0",
        "jest-environment-jsdom": "^29.7.0"
    }
}
